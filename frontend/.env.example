# Sao chép thành ".env" nếu backend chạy ở địa chỉ khác (Vite chỉ đọc biến bắt đầu bằng VITE_)
VITE_API_URL=http://localhost:5000/api
# Địa chỉ gốc của backend, dùng để hiển thị ảnh upload (/uploads/...)
VITE_ASSET_URL=http://localhost:5000

# --- Đăng nhập Google (OAuth2 Client ID) ---
# Điền Google Client ID từ Google Cloud Console (dạng xxxxxxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
