# Cách 1: dùng ảnh QR chuyển khoản bạn tự tạo (đường dẫn URL hoặc /sepay-qr.png).
# Với QR tĩnh, khách nhập số tiền và nội dung đơn hiển thị trên màn hình.
# Nhân viên xác nhận đã nhận tiền trong Admin.
SEPAY_QR_IMAGE_URL=/sepay-qr.png

# Cách 2: để backend tạo QR có sẵn số tiền và nội dung chuyển khoản
# SEPAY_BANK=Vietcombank
# SEPAY_ACCOUNT=YOUR_ACCOUNT_NUMBER
# SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# Giá vé cơ bản
SEAT_PRICE=95000

# Trợ lý AI cục bộ cho trang chat/index.html (cần cài và chạy Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Admin login: copy this file to .env and replace both values before use
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
