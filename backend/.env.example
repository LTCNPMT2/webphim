# Sao chép file này thành ".env" rồi chỉnh giá trị (KHÔNG commit file .env lên git)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL của XAMPP: user mặc định là root, mật khẩu để trống
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=movie_booking

# Tạo chuỗi bí mật: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai_va_ngau_nhien
JWT_EXPIRES_IN=7d

# --- Đặt vé (không bắt buộc, đã có giá trị mặc định) ---
# Số phút giữ ghế khi chưa thanh toán (mặc định 10)
HOLD_MINUTES=10
# Chỉ được hủy vé đã thanh toán trước giờ chiếu ít nhất N giờ (mặc định 2)
CANCEL_BEFORE_HOURS=2

# --- Cấu hình Cổng thanh toán SePay (VietQR tự động) ---
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_BANK_BRAND=MBBank
SEPAY_ACCOUNT_NUMBER=0931883988
SEPAY_ACCOUNT_NAME=NGUYEN TRONG BANG

# --- Đăng nhập Google (OAuth2 Client ID) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- CẤU HÌNH DỊCH VỤ GỬI EMAIL (Nodemailer SMTP MIỄN PHÍ) ---
# Lựa chọn 1: Gmail SMTP Miễn phí (Khuyên dùng khi bắt đầu)
#   Tạo App Password (mật khẩu ứng dụng 16 ký tự) tại: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Lựa chọn 2: Brevo SMTP Miễn phí (Gói 300 emails/ngày miễn phí vĩnh viễn)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_key

# Lựa chọn 3: Resend SMTP Miễn phí (Gói 3.000 emails/tháng miễn phí)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key

# Tên và địa chỉ hiển thị của người gửi email
MAIL_FROM_NAME=Cine Star Cinema
MAIL_FROM_ADDRESS=no-reply@cinestar.vn
